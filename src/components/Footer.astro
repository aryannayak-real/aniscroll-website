---
import Icon from './Icon.astro';
import { site, url } from '../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'App',
    links: [
      { label: 'Features', href: `${url('')}#features` },
      { label: 'Dictionary', href: `${url('')}#dictionary` },
      { label: 'Download', href: `${url('')}#download` },
      { label: 'All releases', href: site.releases, external: true },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: site.repo, external: true },
      { label: 'Report an issue', href: site.issues, external: true },
      { label: 'Discord', href: site.discord, external: true },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Privacy', href: url('privacy/') },
      { label: 'License', href: site.license, external: true },
      { label: 'Website source', href: 'https://github.com/aryannayak-real/aniscroll-website', external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="brand" href={url('')} aria-label="AniScroll home">
          <img src={url('icon-512.png')} width="40" height="40" alt="" />
          <span>AniScroll</span>
        </a>
        <p>Manga, anime, novels, and language learning in one immersive Android app.</p>
        <div class="footer-social">
          <a href={site.repo} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Icon name="github" size={19} />
          </a>
          <a href={site.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord">
            <Icon name="discord" size={19} />
          </a>
        </div>
      </div>

      <div class="footer-links">
        {columns.map((column) => (
          <div>
            <h3>{column.title}</h3>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} AniScroll. Free and open source.</p>
      <p>
        Built with Astro · Hosted on GitHub Pages · Made for readers and language learners.
      </p>
    </div>
    <p class="footer-credit">
      AniScroll builds on the work of Mihon, Chimahon, Komikku, Yomitan, and Hoshidicts. It is an
      independent project and is not affiliated with those upstream projects.
    </p>
  </div>
</footer>
