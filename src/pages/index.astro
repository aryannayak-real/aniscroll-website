---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { site, url } from '../lib/site';

const faqs = [
  {
    question: 'Is AniScroll free?',
    answer:
      'Yes. AniScroll is free and open source. There are no ads and no account is required.',
  },
  {
    question: 'Do I need to import a dictionary?',
    answer:
      'No. Online lookup works out of the box. If you want offline definitions, pitch accent, or frequency data, import a Yomitan-compatible ZIP dictionary from the dictionary settings.',
  },
  {
    question: 'Which languages work online?',
    answer:
      'Japanese lookups use Jisho and JMdict data. Chinese, Korean, and other languages use Wiktionary. Offline language support depends on the dictionaries you import.',
  },
  {
    question: 'Is my reading data private?',
    answer:
      'Your library stays on your device. Online dictionary lookups send only the searched term to the selected provider and can be turned off in settings. Backups can be protected with a password.',
  },
  {
    question: 'How do updates work?',
    answer:
      'Download the latest APK from GitHub Releases and install it over your current version. Your library, settings, and reading progress are preserved.',
  },
  {
    question: 'Does AniScroll support local content?',
    answer:
      'Yes. AniScroll supports local manga, EPUB novels, .mokuro content, and downloaded chapters alongside online sources.',
  },
  {
    question: 'Can I use extensions and source repositories?',
    answer:
      'Yes. AniScroll supports compatible Mihon and Komikku extension repositories, plus novel source plugins that are verified against repository-provided checksums.',
  },
  {
    question: 'Is there an iOS version?',
    answer:
      'No. AniScroll is built for Android. The current release requires Android 8.0 or newer.',
  },
];
---

<BaseLayout>
  <Header />

  <main id="main">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> Open source · Android · Free</span>
          <h1>Every story.<br /><span class="gradient-text">One scroll.</span></h1>
          <p class="lede">
            Manga, anime, novels, dictionaries, OCR, and Anki mining — together in one immersive
            Android app built for readers and language learners.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={site.latestRelease} target="_blank" rel="noopener noreferrer">
              <Icon name="download" size={19} />
              Download for Android
            </a>
            <a class="btn btn-ghost" href="#features">
              Explore features
              <Icon name="chevron-down" size={18} />
            </a>
          </div>
          <ul class="hero-meta">
            <li>Manga · Anime · Novels</li>
            <li>Android 8.0+</li>
            <li>No account required</li>
          </ul>
        </div>

        <div class="hero-visual" data-reveal>
          <div class="hero-halo" aria-hidden="true"></div>

          <figure class="hero-media-card">
            <img
              src={url('images/anime-card.jpg')}
              width="1400"
              height="788"
              alt="AniScroll anime player with a subtitle dictionary popup"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption><Icon name="play" size={15} /> Anime + subtitles</figcaption>
          </figure>

          <div class="phone phone-back">
            <img
              src={url('images/dictionary-screen.jpg')}
              width="720"
              height="1478"
              alt="AniScroll dictionary search for the Japanese word manga"
              loading="eager"
            />
          </div>

          <div class="phone phone-main">
            <img
              src={url('images/manga-popup-screen.jpg')}
              width="600"
              height="1368"
              alt="AniScroll manga reader with a dictionary popup open over a panel"
              loading="eager"
            />
          </div>

          <div class="floating-chip chip-dictionary">
            <Icon name="dictionary" size={17} />
            Jisho + Wiktionary
          </div>
          <div class="floating-chip chip-ocr">
            <Icon name="scan" size={17} />
            OCR built in
          </div>
          <div class="hero-icon-badge">
            <img src={url('icon-512.png')} width="52" height="52" alt="" />
            <span><strong>Open source</strong><small>Built in the open</small></span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats" aria-label="AniScroll at a glance">
      <div class="container stats-grid">
        <div class="stat"><strong>3</strong><span>media types</span></div>
        <div class="stat"><strong>4+</strong><span>dictionary languages</span></div>
        <div class="stat"><strong>0</strong><span>accounts required</span></div>
        <div class="stat"><strong>100%</strong><span>open source</span></div>
      </div>
    </section>

    <section class="section" id="features">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> One place for every story</span>
          <h2>Everything you need to <span class="text-accent">stay in the story.</span></h2>
          <p>
            Read manga, watch anime, open a novel, and look up the words in between — without
            bouncing between apps.
          </p>
        </div>

        <div class="bento">
          <article class="card card-span-7" data-reveal>
            <div class="card-head">
              <div class="card-icon"><Icon name="book" size={22} /></div>
              <span class="card-kicker">Manga</span>
            </div>
            <h3>Manga, panel by panel</h3>
            <p>
              A native reader with online sources, local files, and the tools to follow every
              panel without losing your place.
            </p>
            <ul class="card-list">
              <li><Icon name="check" size={15} /> Online sources and local libraries</li>
              <li><Icon name="check" size={15} /> Panel-by-panel navigation</li>
              <li><Icon name="check" size={15} /> .mokuro reading with OCR overlays</li>
            </ul>
          </article>

          <article class="card card-span-5 card-media" data-reveal>
            <img
              src={url('images/anime-card.jpg')}
              width="1400"
              height="788"
              alt=""
              loading="lazy"
            />
            <div class="card-media-overlay"></div>
            <div class="card-media-body">
              <span class="card-kicker"><Icon name="play" size={14} /> Anime</span>
              <h3>Watch with the dictionary open</h3>
              <p>MPV playback, subtitle lookup, Jimaku integration, and frame OCR.</p>
            </div>
          </article>

          <article class="card card-span-5 card-media card-media-novel" data-reveal>
            <img
              src={url('images/novel-screen.jpg')}
              width="600"
              height="1277"
              alt=""
              loading="lazy"
            />
            <div class="card-media-overlay"></div>
            <div class="card-media-body">
              <span class="card-kicker"><Icon name="feather" size={14} /> Novels</span>
              <h3>Novels in the same flow</h3>
              <p>Read EPUB and supported novel content with the same lookup tools.</p>
            </div>
          </article>

          <article class="card card-span-7" data-reveal>
            <div class="card-head">
              <div class="card-icon"><Icon name="dictionary" size={22} /></div>
              <span class="card-kicker">Dictionary</span>
            </div>
            <h3>A dictionary that comes with the app</h3>
            <p>
              Start looking up words immediately with the online fallback, then import offline
              dictionaries when you want deeper data.
            </p>
            <ul class="card-list">
              <li><Icon name="check" size={15} /> Online fallback for Japanese, Chinese, and Korean</li>
              <li><Icon name="check" size={15} /> Imported ZIP dictionaries for offline control</li>
              <li><Icon name="check" size={15} /> Pitch accent, frequencies, and recursive lookups</li>
            </ul>
          </article>

          <article class="card card-span-6" data-reveal>
            <div class="card-head">
              <div class="card-icon"><Icon name="scan" size={22} /></div>
              <span class="card-kicker">Screen OCR</span>
            </div>
            <h3>Turn any text into a lookup</h3>
            <p>
              Capture text from manga pages, video frames, or other apps and jump straight into
              the dictionary.
            </p>
          </article>

          <article class="card card-span-6" data-reveal>
            <div class="card-head">
              <div class="card-icon"><Icon name="cards" size={22} /></div>
              <span class="card-kicker">Anki</span>
            </div>
            <h3>Mine a card in one tap</h3>
            <p>
              Keep the sentence, crop the panel, map your fields, and check for duplicates before
              the card reaches Anki.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dictionary" id="dictionary">
      <div class="container split">
        <div class="split-copy" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> Native dictionary</span>
          <h2>Look up a word without setting anything up.</h2>
          <p>
            AniScroll includes an online fallback out of the box. Japanese lookups use Jisho and
            JMdict data; Chinese, Korean, and other languages use Wiktionary. Import
            Yomitan-compatible ZIP dictionaries when you want a fully offline library with pitch
            accent and frequency data.
          </p>
          <ul class="check-list">
            <li><Icon name="check" size={17} /> Online fallback enabled by default</li>
            <li><Icon name="check" size={17} /> Japanese, Chinese, Korean, and more</li>
            <li><Icon name="check" size={17} /> Offline ZIP dictionaries always supported</li>
            <li><Icon name="check" size={17} /> Disable online lookups in settings</li>
          </ul>
          <div class="language-chips" aria-label="Online dictionary languages">
            <span lang="ja">日本語</span>
            <span lang="zh">中文</span>
            <span lang="ko">한국어</span>
            <span>More via Wiktionary</span>
          </div>
          <div class="note-box">
            <Icon name="shield" size={19} />
            <p>
              Online lookups send only the searched word to the selected provider. Disable the
              fallback in settings to keep lookups fully offline.
            </p>
          </div>
        </div>

        <div class="split-media" data-reveal>
          <div class="phone-frame phone-frame-large">
            <img
              src={url('images/dictionary-screen.jpg')}
              width="720"
              height="1478"
              alt="AniScroll dictionary search showing Japanese definitions, pitch accent, and JMdict data"
              loading="lazy"
            />
          </div>
          <div class="media-chip media-chip-top">
            <Icon name="globe" size={16} />
            Online fallback on by default
          </div>
          <div class="media-chip media-chip-bottom">
            <Icon name="check" size={16} />
            Offline ZIP import supported
          </div>
        </div>
      </div>
    </section>

    <section class="section section-mining" id="mining">
      <div class="container split split-reverse">
        <div class="split-media" data-reveal>
          <div class="phone-frame phone-frame-large">
            <img
              src={url('images/manga-popup-screen.jpg')}
              width="600"
              height="1368"
              alt="AniScroll manga reader with a Japanese dictionary popup and Anki controls"
              loading="lazy"
            />
          </div>
          <div class="media-chip media-chip-top">
            <Icon name="cards" size={16} />
            One tap to Anki
          </div>
        </div>

        <div class="split-copy" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> Mining made simple</span>
          <h2>Turn a sentence into a card before you lose the moment.</h2>
          <p>
            Tap a word while reading manga, watching anime, or scrolling a novel. AniScroll keeps
            the context, lets you choose a screenshot, and sends the card to Anki with your field
            mapping.
          </p>
          <ol class="steps">
            <li>
              <span class="step-number">01</span>
              <div>
                <h3>Tap a word</h3>
                <p>Look up the expression, reading, and meaning without leaving the page.</p>
              </div>
            </li>
            <li>
              <span class="step-number">02</span>
              <div>
                <h3>Keep the context</h3>
                <p>Capture the sentence and crop the panel around it.</p>
              </div>
            </li>
            <li>
              <span class="step-number">03</span>
              <div>
                <h3>Send to Anki</h3>
                <p>Map fields, check for duplicates, and create the card.</p>
              </div>
            </li>
          </ol>
          <a class="text-link" href={`${site.repo}#readme`} target="_blank" rel="noopener noreferrer">
            Explore the full feature list
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="screenshots">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> A closer look</span>
          <h2>Designed to disappear into the story.</h2>
          <p>Dark by default, dense where it matters, and built for long reading sessions.</p>
        </div>

        <div class="screens-grid">
          <figure class="screen-card" data-reveal>
            <img
              src={url('images/novel-screen.jpg')}
              width="600"
              height="1277"
              alt="AniScroll novel reader showing vertical Japanese text"
              loading="lazy"
            />
            <figcaption><strong>Novels</strong><span>A quiet, focused reading view.</span></figcaption>
          </figure>
          <figure class="screen-card screen-card-tall" data-reveal>
            <img
              src={url('images/dictionary-screen.jpg')}
              width="720"
              height="1478"
              alt="AniScroll dictionary showing local definitions and pitch accent"
              loading="lazy"
            />
            <figcaption><strong>Dictionary</strong><span>Local data, online fallback, pitch accent.</span></figcaption>
          </figure>
          <figure class="screen-card" data-reveal>
            <img
              src={url('images/manga-popup-screen.jpg')}
              width="600"
              height="1368"
              alt="AniScroll manga panel with a dictionary popup"
              loading="lazy"
            />
            <figcaption><strong>Mining</strong><span>Look up a word without leaving the panel.</span></figcaption>
          </figure>
          <figure class="screen-card screen-card-wide" data-reveal>
            <img
              src={url('images/anime-card.jpg')}
              width="1400"
              height="788"
              alt="AniScroll anime player with a subtitle dictionary popup"
              loading="lazy"
            />
            <figcaption><strong>Anime</strong><span>Subtitle lookup and frame OCR while you watch.</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section-security">
      <div class="container">
        <div class="security-panel" data-reveal>
          <div class="security-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> Local-first by default</span>
            <h2>Your library stays yours.</h2>
            <p>
              AniScroll does not require an account and keeps your library on your device. When
              you choose to back up, protect it with a password. When you go online, the app keeps
              network trust strict.
            </p>
            <a class="text-link" href={`${site.repo}#readme`} target="_blank" rel="noopener noreferrer">
              Read the security notes
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>

          <div class="security-grid">
            <div class="security-item">
              <Icon name="lock" size={21} />
              <h3>Encrypted backups</h3>
              <p>Optional AES-256-GCM backups with PBKDF2 key derivation.</p>
            </div>
            <div class="security-item">
              <Icon name="shield" size={21} />
              <h3>Plugin checks</h3>
              <p>Novel source plugins are verified against SHA-256 checksums.</p>
            </div>
            <div class="security-item">
              <Icon name="globe" size={21} />
              <h3>Hardened WebViews</h3>
              <p>Restricted file access, Safe Browsing, and strict network trust.</p>
            </div>
            <div class="security-item">
              <Icon name="book" size={21} />
              <h3>No account required</h3>
              <p>Your library is local. No sign-up, no profile, no cloud requirement.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-download" id="download">
      <div class="container">
        <div class="download-panel" data-reveal>
          <div class="download-glow" aria-hidden="true"></div>
          <span class="eyebrow"><span class="eyebrow-dot"></span> Ready when you are</span>
          <h2>Start your next scroll.</h2>
          <p>
            Download the latest stable build for Android. Your library, settings, and reading
            progress stay on your device.
          </p>
          <div class="download-actions">
            <a
              class="btn btn-primary btn-large"
              href={site.latestRelease}
              target="_blank"
              rel="noopener noreferrer"
              data-download-link
            >
              <Icon name="download" size={20} />
              Download latest APK
            </a>
            <a class="btn btn-ghost btn-large" href={site.releases} target="_blank" rel="noopener noreferrer">
              All releases
            </a>
          </div>
          <div class="release-meta">
            <span class="version-pill" data-release-version>{site.fallbackVersion}</span>
            <span data-release-date>Latest stable release</span>
          </div>
          <p class="download-note">
            Android 8.0+ · arm64-v8a, armeabi-v7a, x86, x86_64 · Universal APK available
          </p>
        </div>
      </div>
    </section>

    <section class="section section-faq" id="faq">
      <div class="container faq-layout">
        <div class="faq-head" data-reveal>
          <span class="eyebrow"><span class="eyebrow-dot"></span> Questions</span>
          <h2>Answers before you install.</h2>
          <p>
            Everything you need to know about dictionaries, updates, privacy, and running
            AniScroll on Android.
          </p>
          <a class="text-link" href={site.issues} target="_blank" rel="noopener noreferrer">
            Ask on GitHub
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>

        <div class="faq-list" data-reveal>
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span>{faq.question}</span>
                <span class="faq-icon"><Icon name="chevron-down" size={18} /></span>
              </summary>
              <div class="faq-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const versionNodes = document.querySelectorAll('[data-release-version]');
    const dateNode = document.querySelector('[data-release-date]');
    const downloadNode = document.querySelector('[data-download-link]');

    fetch('https://api.github.com/repos/aryannayak-real/AniScroll/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error('release unavailable'))))
      .then((release) => {
        const version = release.tag_name || release.name;
        if (version) {
          versionNodes.forEach((node) => {
            node.textContent = version;
          });
        }

        if (dateNode && release.published_at) {
          const date = new Date(release.published_at);
          dateNode.textContent = `Released ${new Intl.DateTimeFormat('en', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          }).format(date)}`;
        }

        const universal = (release.assets || []).find((asset) =>
          /^AniScroll-\d[\d.]*\.apk$/i.test(asset.name),
        );
        if (universal && downloadNode instanceof HTMLAnchorElement) {
          downloadNode.href = universal.browser_download_url;
        }
      })
      .catch(() => {
        // Keep the static release-page fallback.
      });
  </script>
</BaseLayout>
